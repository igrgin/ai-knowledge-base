{
  "schemaVersion": 1,
  "pluginVersion": "0.1.0",
  "records": {
    "changeRoot": "docs/changes",
    "incidentRoot": "docs/incidents"
  },
  "owners": {
    "roles": {
      "intent": [
        "project-owner"
      ],
      "design": [
        "project-owner"
      ],
      "plan": [
        "project-owner"
      ],
      "review": [
        "project-owner"
      ],
      "release": [
        "project-owner"
      ]
    },
    "people": {
      "project-owner": {
        "name": "Project owner (user in the adoption conversation)"
      }
    }
  },
  "policies": {
    "review": {
      "path": "docs/policies/review.md",
      "owner": "project-owner"
    }
  },
  "commands": {
    "backendTests": {
      "path": "backend/pom.xml"
    },
    "frontendTests": {
      "path": "frontend/package.json"
    },
    "build": {
      "path": "pom.xml"
    },
    "localDevelopment": {
      "path": "docs/local-development.md",
      "section": "Start and stop"
    }
  },
  "controls": {},
  "capabilities": {
    "concurrency": {
      "maxParallelTasks": 1
    },
    "operationalJobs": {
      "enabled": false
    }
  }
}
