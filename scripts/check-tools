#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"
require_java26
java -version 2>&1 | head -3
./mvnw -q -N enforcer:enforce@toolchain
[[ "$(node --version)" == v24.22.1 ]] || { echo 'Run ./scripts/setup-node (Node 24.22.1 required)' >&2; exit 1; }
node --version
npm --version
docker compose version
docker info --format '{{.ServerVersion}}'
