#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"
./scripts/check-tools
python3 - <<'PYTHON'
import os, socket
for name, default in [('APP_PORT', '8080'), ('FRONTEND_PORT', '5173')]:
    try:
        with socket.socket() as probe:
            probe.bind(('127.0.0.1', int(os.environ.get(name, default))))
    except OSError:
        raise SystemExit(f'{name} port is occupied; choose another exported port')
PYTHON
docker compose up -d --wait db
npm ci --prefix frontend
./mvnw -pl backend clean package -DskipTests
java -jar backend/target/backend-0.1.0-SNAPSHOT.jar &
backend_pid=$!
(cd frontend && exec node node_modules/vite/bin/vite.js --host 127.0.0.1) &
frontend_pid=$!
cleanup() {
  kill "$backend_pid" "$frontend_pid" 2>/dev/null || true
  wait "$backend_pid" "$frontend_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
wait "$frontend_pid"
