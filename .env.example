# Optional configuration reference. No command sources this file.
# Compose reads DB_* from .env; Java reads exported SPRING_* variables.
# For custom local database settings, export matching values for both clients.
DB_PORT=54329
DB_NAME=knowledge_base
DB_USER=knowledge_base
DB_PASSWORD=local-development-only
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54329/knowledge_base?connectTimeout=2&socketTimeout=3
SPRING_DATASOURCE_USERNAME=knowledge_base
SPRING_DATASOURCE_PASSWORD=local-development-only
SERVER_PORT=8080
APP_PORT=8080
FRONTEND_PORT=5173

# Direct Java prod profile requires ALL of these, with deployment-supplied values:
# SERVER_ADDRESS=
# SERVER_PORT=
# DATABASE_URL=
# DATABASE_USER=
# DATABASE_PASSWORD=
